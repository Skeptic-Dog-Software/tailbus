{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Skeptic-Dog-Software/tailbus/schema/acr.schema.json",
  "title": "A repository's ACR config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {"const": 1},
    "human_gate": {"enum": ["per-round", "ends", "exception"]},
    "max_rounds": {"type": "integer", "minimum": 1},
    "review_scope": {"enum": ["whole-pr", "bottom-of-stack"]},
    "not_findings": {"type": "string", "description": "Path to the decided non-issues list"},
    "always_escalate": {"type": "array", "items": {"type": "string"}},
    "tiers": {
      "type": "array",
      "description": "Ordered from lowest to highest",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "fan_out"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "paths": {"$ref": "#/$defs/strings"},
              "description": {"type": "string"}
            }
          },
          "fan_out": {"type": "integer", "minimum": 1},
          "required": {"$ref": "#/$defs/strings"}
        }
      }
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criteria", "triggers"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "criteria": {"type": "string"},
          "triggers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "paths": {"$ref": "#/$defs/strings"},
              "content": {"$ref": "#/$defs/strings"},
              "description": {"type": "string"}
            }
          },
          "binding": {"type": "string"},
          "include_generated": {"type": "boolean", "description": "This lens's reviewers get generated files in the diff too"},
          "severity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Medium": {"$ref": "#/$defs/action"},
              "Low": {"$ref": "#/$defs/action"}
            }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "not_ready": {"type": "string"},
            "ready": {"type": "string"},
            "waiting": {"type": "string"},
            "confirmed": {"type": "string"}
          }
        },
        "comment": {"enum": ["summary", "full"]}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizer": {"type": "string"},
        "orchestrator": {"type": "string"},
        "reviewer": {"type": "string"},
        "judge": {"type": "string"}
      }
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "description": "Generated files are left out of the diff a review sends, each listed with its line counts. Reviewers can still read them in the repository. Generated means by path: code generators' naming conventions, these paths, or the base's .gitattributes linguist-generated; never by a file's contents",
      "properties": {
        "exclude": {"type": "boolean", "description": "Leave generated files out. Default true"},
        "paths": {"$ref": "#/$defs/strings", "description": "More paths that are generated, besides code generators' naming conventions"},
        "keep": {"$ref": "#/$defs/strings", "description": "Paths never treated as generated"}
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "description": "What estimates are made from. A binding that sets its own prices in the user's config keeps them",
      "properties": {
        "prices": {
          "type": "object",
          "description": "US dollars per million tokens, by model, or by binding name for a binding that names no model",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input_per_mtok", "output_per_mtok"],
            "properties": {
              "input_per_mtok": {"type": "number", "minimum": 0},
              "output_per_mtok": {"type": "number", "minimum": 0},
              "cached_input_per_mtok": {"type": "number", "minimum": 0, "description": "Input read from a cache. Left out, it costs what other input does"},
              "cache_write_per_mtok": {"type": "number", "minimum": 0, "description": "Input written to a cache. Left out, it costs what other input does"}
            }
          }
        },
        "per_call": {
          "type": "object",
          "description": "Tokens each call by a role takes beyond the text ACR sends it and reads back: what its tools read, its turns, its thinking",
          "additionalProperties": false,
          "properties": {
            "sizer": {"$ref": "#/$defs/per_call"},
            "orchestrator": {"$ref": "#/$defs/per_call"},
            "reviewer": {"$ref": "#/$defs/per_call"},
            "judge": {"$ref": "#/$defs/per_call"}
          }
        }
      }
    },
    "stages": {
      "description": "What every round does besides its lenses' reviewers. context: every role gets what the repository's history says about the changed files. claims: a lens that checks every claim the change makes about itself. mutation: a lens that proposes small breaks in the changed code, which the pipeline runs against the tests; a break they miss is a finding. probes: a lens that writes and runs scenarios of what the change says it does, which needs a binding with a shell.",
      "type": "array",
      "items": {"enum": ["context", "claims", "mutation", "probes"]},
      "uniqueItems": true
    },
    "tests": {
      "description": "How the repository's tests run, for the mutation stage.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "description": "Run from the repository's root. {tests} stands for the test files to run. Without it, it's found from the repository's files: Flutter, Cargo, Go, npm or pytest."},
        "parallel": {"type": "integer", "minimum": 1, "description": "How many mutants run at once."},
        "timeout": {"type": "integer", "minimum": 1, "description": "Seconds one run of the tests may take."},
        "mutants": {"type": "integer", "minimum": 1, "description": "How many mutants a reviewer proposes in a round."}
      }
    }
  },
  "$defs": {
    "per_call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cache_read_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "action": {"enum": ["blocks", "blocks-unless-waived", "never-blocks", "drop"]}
  }
}
